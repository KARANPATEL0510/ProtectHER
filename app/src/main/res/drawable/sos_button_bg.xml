<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/tech_sos_ring_outer" />
            <size android:width="200dp" android:height="200dp" />
        </shape>
    </item>
    <!-- Mid glow ring -->
    <item
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp">
        <shape android:shape="oval">
            <solid android:color="@color/tech_sos_ring_mid" />
        </shape>
    </item>
    <!-- Main button body -->
    <item
        android:bottom="24dp"
        android:left="24dp"
        android:right="24dp"
        android:top="24dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#E53E4F"
                android:centerColor="#D42A3D"
                android:endColor="#B02A3A"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
